{{! Features Tab for Critters: critter powers, weapons and qualities }}
<section
  class='tab features scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='features'
>
{{#unless limited}}

{{! Critter powers }}
<section class="section powers">
  <header class="section-head">
    <h2 class="section-title">{{localize 'shadowrun6.section.critterpowers.title'}}</h2>
    {{#if @root.editMode}}
    <div class="item-controls">
      <a class="item-control item-create" data-tooltip="{{localize 'DOCUMENT.New' type=(localize 'TYPES.Item.critterpower')}}" data-action="createDoc" data-document-class="Item" data-type="critterpower"><i class="fas fa-plus"></i></a>
    </div>
    {{/if}}
  </header>
  <ol class="section-list">
    {{#each powers as |item|}}
    <li class="section-item" data-item-id="{{item.id}}" data-document-class="Item">
      <div class="section-row">
        <div class="section-name draggable" data-item-id="{{item.id}}" draggable="true">{{item.name}}</div>
        <div class="section-column item-controls">
          {{#if item.system.skill}}
          <a class="item-control" data-tooltip="{{skillHint @root.actor item.system.skill}}" data-action="roll" data-roll-type="item" data-item-id="{{item.id}}" data-uuid="{{item.uuid}}"><i class="fas fa-dice-six"></i></a>
          {{/if}}
          <a class="item-control item-edit" data-tooltip="{{localize 'DOCUMENT.Update' type=(localize 'TYPES.Item.critterpower')}}" data-action="viewDoc"><i class="fas fa-edit"></i></a>
          {{#if @root.editMode}}
          <a class="item-control item-delete" data-tooltip="{{localize 'DOCUMENT.Delete' type=(localize 'TYPES.Item.critterpower')}}" data-action="deleteDoc"><i class="fas fa-trash"></i></a>
          {{/if}}
        </div>
      </div>
    </li>
    {{/each}}
  </ol>
</section>

{{! Weapons }}
<section class="section weapons">
  <header class="section-head">
    <h2 class="section-title">{{localize 'shadowrun6.section.weapon.title'}}</h2>
    {{#if @root.editMode}}
    <div class="item-controls">
      <a class="item-control item-create" data-tooltip="{{localize 'DOCUMENT.New' type=(localize 'TYPES.Item.gear')}}" data-action="createDoc" data-document-class="Item" data-type="gear" data-system.type="WEAPON_SPECIAL"><i class="fas fa-plus"></i></a>
    </div>
    {{/if}}
  </header>
  <ol class="section-list">
    {{#each weapons as |item|}}
    <li class="section-item" data-item-id="{{item.id}}" data-document-class="Item">
      <div class="section-row">
        <div class="section-name draggable" data-item-id="{{item.id}}" draggable="true">{{item.name}}</div>
        <div class="section-column item-controls">
          <a class="item-control" data-tooltip="{{localize 'SR6.title.rollSomething' typeOfRoll=item.name}}" data-action="roll" data-roll-type="item" data-item-id="{{item.id}}" data-uuid="{{item.uuid}}"><i class="fas fa-dice-six"></i></a>
          <a class="item-control item-edit" data-tooltip="{{localize 'DOCUMENT.Update' type=(localize 'TYPES.Item.gear')}}" data-action="viewDoc"><i class="fas fa-edit"></i></a>
          {{#if @root.editMode}}
          <a class="item-control item-delete" data-tooltip="{{localize 'DOCUMENT.Delete' type=(localize 'TYPES.Item.gear')}}" data-action="deleteDoc"><i class="fas fa-trash"></i></a>
          {{/if}}
        </div>
      </div>
    </li>
    {{/each}}
  </ol>
</section>

{{! Qualities }}
<section class="section qualities">
  <header class="section-head">
    <h2 class="section-title">{{localize 'shadowrun6.section.qualities'}}</h2>
    {{#if @root.editMode}}
    <div class="item-controls">
      <a class="item-control item-create" data-tooltip="{{localize 'DOCUMENT.New' type=(localize 'TYPES.Item.quality')}}" data-action="createDoc" data-document-class="Item" data-type="quality"><i class="fas fa-plus"></i></a>
    </div>
    {{/if}}
  </header>
  <ol class="section-list">
    {{#each qualities as |item|}}
    <li class="section-item" data-item-id="{{item.id}}" data-document-class="Item">
      <div class="section-row">
        <div class="section-name draggable" data-item-id="{{item.id}}" draggable="true">{{item.name}}</div>
        <div class="section-column item-controls">
          <a class="item-control item-edit" data-tooltip="{{localize 'DOCUMENT.Update' type=(localize 'TYPES.Item.quality')}}" data-action="viewDoc"><i class="fas fa-edit"></i></a>
          {{#if @root.editMode}}
          <a class="item-control item-delete" data-tooltip="{{localize 'DOCUMENT.Delete' type=(localize 'TYPES.Item.quality')}}" data-action="deleteDoc"><i class="fas fa-trash"></i></a>
          {{/if}}
        </div>
      </div>
    </li>
    {{/each}}
  </ol>
</section>

{{/unless}}
</section>
