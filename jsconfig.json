{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "types": [
      "fvtt-types"
    ],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "module/**/*.js",
    "module/**/*.mjs",
    "types/**/*.d.ts",
    "types/**/*.js"
  ]
}
